<Window x:Class="ApiTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM API Tester" Height="720" Width="1060"
        Icon="Assets\AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderBrush" Value="#B9C6D6"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
        <Style x:Key="EditorBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#223047"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10" Background="#F4F7FB">

        <!-- ===== 顶部：连接与参数 ===== -->
        <GroupBox Header="Connection &amp; Parameters" DockPanel.Dock="Top">
            <StackPanel Margin="6">
                <!-- 协议 + Base URL -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="Protocol:" Width="74"/>
                    <ComboBox x:Name="ProtocolBox" Width="220"/>
                    <Label Content="Base URL:" Width="74" Margin="12,0,0,0"/>
                    <TextBox x:Name="BaseUrlBox" Width="320"/>
                    <CheckBox x:Name="AutoFillUrlBox" Content="Auto-fill URL" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <!-- API Key + List Models -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="API Key:" Width="74"/>
                    <TextBox x:Name="KeyBox" Width="360"/>
                    <Button x:Name="ListModelsBtn" Content="List Models" Width="100" Margin="12,0,0,0"/>
                </StackPanel>
                <!-- Model + thinking + output length -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="Model:" Width="74"/>
                    <ComboBox x:Name="ModelBox" Width="280" IsEditable="True"/>
                    <Label Content="Thinking:" Width="70" Margin="12,0,0,0"/>
                    <ComboBox x:Name="ThinkingBox" Width="96"/>
                    <Label Content="Max Output Tokens:" Width="124" Margin="12,0,0,0"/>
                    <TextBox x:Name="MaxTokensBox" Width="70" Text="1024"/>
                </StackPanel>
                <!-- Preset + Advanced -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="Preset:" Width="74"/>
                    <ComboBox x:Name="PresetBox" Width="220" IsEditable="True"/>
                    <Button x:Name="SavePresetBtn" Content="Save" Width="70" Margin="8,0,0,0"/>
                    <Button x:Name="DelPresetBtn" Content="Delete" Width="70" Margin="8,0,0,0"/>
                    <CheckBox x:Name="AdvancedBox" Content="Advanced" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock x:Name="AdvancedSummaryText" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="#64748B" Visibility="Collapsed"/>
                </StackPanel>
                <!-- Advanced options -->
                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Label Content="Temperature:" Width="74"/>
                        <TextBox x:Name="TempBox" Width="60"/>
                        <CheckBox x:Name="StreamBox" Content="Stream (SSE)" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <Label Content="List Timeout:" Width="86" Margin="16,0,0,0"/>
                        <TextBox x:Name="ListModelsTimeoutBox" Width="50" Text="5"/>
                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#334155"/>
                        <Label Content="Send Timeout:" Width="96" Margin="16,0,0,0"/>
                        <TextBox x:Name="SendTimeoutBox" Width="50" Text="30"/>
                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#334155"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Label Content="System:" Width="74"/>
                        <TextBox x:Name="SystemBox" Width="700"/>
                    </StackPanel>
                </StackPanel>
                <!-- Message -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="Message:" Width="74"/>
                    <TextBox x:Name="MessageBox" Width="700" Height="26" Text="Hello"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <Button x:Name="OpenAiJuiceBtn" Content="OpenAI Juice" Width="106" Height="26"
                            VerticalAlignment="Top" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ===== 底部：状态栏 ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Status: -"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TimeText" Text="Time: -"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TtftText" Text="TTFT: -"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TokensText" Text="Tokens: -"/></StatusBarItem>
        </StatusBar>

        <!-- ===== 中部：左请求预览 / 右响应 ===== -->
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左：请求预览 -->
            <DockPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Request (preview)" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="SendBtn" Content="Send" Width="80" Margin="14,0,0,0"/>
                    <Button x:Name="StopBtn" Content="Stop" Width="60" Margin="6,0,0,0" IsEnabled="False"/>
                    <Button x:Name="CopyReqBtn" Content="Copy" Width="60" Margin="6,0,0,0"/>
                    <CheckBox x:Name="RequestEditModeBox" Content="Editable" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="RequestBox" IsReadOnly="True" FontFamily="Consolas" Style="{StaticResource EditorBoxStyle}"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CBD5E1"/>

            <!-- 右：响应 -->
            <DockPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Response" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="FormatJsonBtn" Content="Format JSON" Width="100" Margin="14,0,0,0"/>
                    <Button x:Name="RawRespBtn" Content="Raw" Width="60" Margin="6,0,0,0"/>
                    <Button x:Name="CopyRespBtn" Content="Copy" Width="60" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="ResponseBox" IsReadOnly="True" FontFamily="Consolas" Style="{StaticResource EditorBoxStyle}"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
