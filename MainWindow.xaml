<Window x:Class="ApiTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM API Tester" Height="720" Width="1060"
        WindowStartupLocation="CenterScreen"
        FontSize="12">
    <DockPanel Margin="8">

        <!-- ===== 顶部：连接与参数 ===== -->
        <GroupBox Header="Connection &amp; Parameters" DockPanel.Dock="Top">
            <StackPanel Margin="6">
                <!-- 协议 + Base URL -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="Protocol:" Width="74"/>
                    <ComboBox x:Name="ProtocolBox" Width="220"/>
                    <Label Content="Base URL:" Width="74" Margin="12,0,0,0"/>
                    <TextBox x:Name="BaseUrlBox" Width="360"/>
                    <CheckBox x:Name="AutoFillUrlBox" Content="Auto-fill URL" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <!-- API Key + Remember + List Models -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="API Key:" Width="74"/>
                    <TextBox x:Name="KeyBox" Width="360"/>
                    <CheckBox x:Name="RememberKeyBox" Content="Remember key" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button x:Name="ListModelsBtn" Content="List Models" Width="100" Margin="12,0,0,0"/>
                </StackPanel>
                <!-- Model + max_tokens + temperature + Stream -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="Model:" Width="74"/>
                    <ComboBox x:Name="ModelBox" Width="280" IsEditable="True"/>
                    <Label Content="max_tokens:" Width="74" Margin="12,0,0,0"/>
                    <TextBox x:Name="MaxTokensBox" Width="70" Text="256"/>
                    <Label Content="temp:" Width="40" Margin="12,0,0,0"/>
                    <TextBox x:Name="TempBox" Width="60"/>
                    <CheckBox x:Name="StreamBox" Content="Stream (SSE)" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <!-- Preset -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="Preset:" Width="74"/>
                    <ComboBox x:Name="PresetBox" Width="220" IsEditable="True"/>
                    <Button x:Name="SavePresetBtn" Content="Save" Width="70" Margin="8,0,0,0"/>
                    <Button x:Name="DelPresetBtn" Content="Delete" Width="70" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- System -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="System:" Width="74"/>
                    <TextBox x:Name="SystemBox" Width="700"/>
                </StackPanel>
                <!-- Message -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Label Content="Message:" Width="74"/>
                    <TextBox x:Name="MessageBox" Width="700" Text="Hello"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ===== 底部：状态栏 ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Status: -"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TimeText" Text="Time: -"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TtftText" Text="TTFT: -"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TokensText" Text="Tokens: -"/></StatusBarItem>
        </StatusBar>

        <!-- ===== 中部：左请求预览 / 右响应 ===== -->
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左：请求预览 -->
            <DockPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Request (preview)" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="SendBtn" Content="Send" Width="80" Margin="14,0,0,0"/>
                    <Button x:Name="StopBtn" Content="Stop" Width="60" Margin="6,0,0,0" IsEnabled="False"/>
                    <Button x:Name="CopyReqBtn" Content="Copy" Width="60" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="RequestBox" IsReadOnly="True" FontFamily="Consolas"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDDDDD"/>

            <!-- 右：响应 -->
            <DockPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Response" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="FormatJsonBtn" Content="Format JSON" Width="100" Margin="14,0,0,0"/>
                    <Button x:Name="RawRespBtn" Content="Raw" Width="60" Margin="6,0,0,0"/>
                    <Button x:Name="CopyRespBtn" Content="Copy" Width="60" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="ResponseBox" IsReadOnly="True" FontFamily="Consolas"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
